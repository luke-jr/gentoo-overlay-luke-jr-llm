EAPI=8

# TypeScript 6, the JavaScript implementation (compiler, language server and the
# JavaScript API), built from source the way upstream's Herebyfile.mjs builds the
# npm package: its sources bundled with esbuild, lib*.d.ts and the localized
# messages generated by its scripts. (::gentoo's dev-lang/typescript installs the
# npm package, i.e. the prebuilt bundles.) The declaration bundles
# (typescript.d.ts) are built by type-checking the sources with the compiler just
# built; upstream formats them with dprint's TypeScript plugin, a prebuilt
# WebAssembly module, which is left out (they then differ in formatting only).
#
# Slotted per exact version, like TypeScript 7 (7.x). Chromium's DevTools build
# uses this version's JavaScript API (front_end/core/i18n/collect-ui-strings.js).

inherit edo git-archive

DESCRIPTION="Superset of JavaScript with optional static typing (TypeScript 6, in JavaScript)"
HOMEPAGE="
	https://www.typescriptlang.org/
	https://github.com/microsoft/TypeScript/
"
# Build-time only: the scripts' dependencies (from git), and type declarations
# the sources are checked against (.d.ts files only; versions from
# package-lock.json).
# The commits the tags below point to (peeled, for annotated tags), checked
# against the tarballs in src_unpack.
TS_COMMIT=607a22a90d1a5a1b507ce01bb8cd7ec020f954e7 # v6.0.2
MINIMIST_COMMIT=6901ee286bc4c16da6830b48b46ce1574703cea1 # v1.2.8
FXP_COMMIT_PARSER=4e7ca80e788a23b07531ac2ff8906e5e9f4bf892 # v5.4.1
SOURCE_MAP_COMMIT=ac518d2f21818146f3310557bd51c13d8cff2ba8 # 0.6.1
FXP_COMMIT_STRNUM=b2c24d6d9cc245e69f58ecac46657acbf8895539
FXP_COMMIT_BUILDER=0107b0f5c7226b2ea358ab87eca4b3d15434e666
SRC_URI="
	https://github.com/microsoft/TypeScript/archive/refs/tags/v${PV}.tar.gz
		-> ${P}.gh.tar.gz
	https://github.com/minimistjs/minimist/archive/refs/tags/v1.2.8.tar.gz
		-> minimistjs-minimist-v1.2.8.gh.tar.gz
	https://github.com/NaturalIntelligence/fast-xml-parser/archive/refs/tags/v5.4.1.tar.gz
		-> NaturalIntelligence-fast-xml-parser-v5.4.1.gh.tar.gz
	https://github.com/NaturalIntelligence/strnum/archive/${FXP_COMMIT_STRNUM}.tar.gz
		-> NaturalIntelligence-strnum-${FXP_COMMIT_STRNUM}.gh.tar.gz
	https://github.com/NaturalIntelligence/fast-xml-builder/archive/${FXP_COMMIT_BUILDER}.tar.gz
		-> NaturalIntelligence-fast-xml-builder-${FXP_COMMIT_BUILDER}.gh.tar.gz
	https://github.com/mozilla/source-map/archive/refs/tags/0.6.1.tar.gz
		-> mozilla-source-map-0.6.1.gh.tar.gz
	https://registry.npmjs.org/@types/node/-/node-25.3.3.tgz
		-> types-node-25.3.3.tgz
	https://registry.npmjs.org/undici-types/-/undici-types-7.18.2.tgz
	https://registry.npmjs.org/@types/source-map-support/-/source-map-support-0.5.10.tgz
		-> types-source-map-support-0.5.10.tgz
"
S="${WORKDIR}/TypeScript-${PV}"

LICENSE="Apache-2.0"
SLOT="${PV}"
KEYWORDS="~amd64 ~arm64"
IUSE="test"
RESTRICT="!test? ( test )"

RDEPEND="net-libs/nodejs"
BDEPEND="
	dev-util/esbuild
	net-libs/nodejs
"

src_unpack() {
	git-archive_verify \
		${P}.gh.tar.gz ${TS_COMMIT} \
		minimistjs-minimist-v1.2.8.gh.tar.gz ${MINIMIST_COMMIT} \
		NaturalIntelligence-fast-xml-parser-v5.4.1.gh.tar.gz ${FXP_COMMIT_PARSER} \
		NaturalIntelligence-strnum-${FXP_COMMIT_STRNUM}.gh.tar.gz ${FXP_COMMIT_STRNUM} \
		NaturalIntelligence-fast-xml-builder-${FXP_COMMIT_BUILDER}.gh.tar.gz ${FXP_COMMIT_BUILDER} \
		mozilla-source-map-0.6.1.gh.tar.gz ${SOURCE_MAP_COMMIT}
	default
}

src_prepare() {
	default

	# What the build scripts import from node_modules.
	local nm="${S}/node_modules"
	mkdir -p "${nm}"/@types "${nm}"/undici-types "${nm}"/typescript \
		"${nm}"/@dprint/formatter "${nm}"/@dprint/typescript || die
	mv "${WORKDIR}"/node "${nm}"/@types/node || die
	mv "${WORKDIR}"/source-map-support "${nm}"/@types/source-map-support || die
	mv "${WORKDIR}"/package/* "${nm}"/undici-types/ || die
	mv "${WORKDIR}"/minimist-1.2.8 "${nm}"/minimist || die
	mv "${WORKDIR}"/source-map-0.6.1 "${nm}"/source-map || die
	mv "${WORKDIR}"/fast-xml-parser-5.4.1 "${nm}"/fast-xml-parser || die
	mv "${WORKDIR}"/strnum-${FXP_COMMIT_STRNUM} "${nm}"/strnum || die
	mv "${WORKDIR}"/fast-xml-builder-${FXP_COMMIT_BUILDER} "${nm}"/fast-xml-builder || die
	# scripts/dtsBundler.mjs uses the compiler being built
	echo '{"name": "typescript", "main": "../../built/local/typescript.js"}' \
		> "${nm}"/typescript/package.json || die
	# and formats its output with dprint's WebAssembly plugin: leave it as is
	echo '{"name": "@dprint/typescript", "type": "module", "main": "index.js"}' \
		> "${nm}"/@dprint/typescript/package.json || die
	echo 'export function getPath() { return new URL("./index.js", import.meta.url).pathname; }' \
		> "${nm}"/@dprint/typescript/index.js || die
	echo '{"name": "@dprint/formatter", "type": "module", "main": "index.js"}' \
		> "${nm}"/@dprint/formatter/package.json || die
	echo 'export function createFromBuffer() { return { setConfig() {}, formatText({ fileText }) { return fileText; } }; }' \
		> "${nm}"/@dprint/formatter/index.js || die
}

# _bundle <entry> <output> [esbuild args]: Herebyfile.mjs' createBundler
_bundle() {
	local entry=${1} output=${2}
	shift 2
	edo "${ESBUILD}" "${entry}" --bundle --outfile="${output}" --platform=node \
		--target=es2020,node14.17 --format=cjs --packages=external --log-level=warning \
		--banner:js="$(<scripts/CopyrightNotice.txt)"$'\n'"${BANNER}" "$@"
}

# _bundle_public <entry> <output>: createBundler's usePublicAPI (the bundle uses
# typescript.js instead of including the compiler)
_bundle_public() {
	cp src/typescript/typescript.ts "${T}"/typescript.ts || die
	echo 'export * from "./typescript.js";' > src/typescript/typescript.ts || die
	_bundle "${1}" "${2}" --external:./typescript.js
	cp "${T}"/typescript.ts src/typescript/typescript.ts || die
}

# _compile_cache_shim <name>: entrypointBuildTask's enableCompileCache shim
_compile_cache_shim() {
	printf '%s\n' \
		"// This file is a shim which defers loading the real module until the compile cache is enabled." \
		"try {" \
		'  const { enableCompileCache } = require("node:module");' \
		"  if (enableCompileCache) {" \
		"    enableCompileCache();" \
		"  }" \
		"} catch {}" \
		"module.exports = require(\"./_${1}\");" > "built/local/${1}" || die
}

src_compile() {
	local ESBUILD BANNER=""
	ESBUILD=$(best_version -b dev-util/esbuild) || die "dev-util/esbuild not found"
	ESBUILD="${BROOT}/usr/bin/esbuild-$(ver_cut 1-3 "${ESBUILD#dev-util/esbuild-}")"
	mkdir -p built/local || die

	# generate-diagnostics, lib, generate-types-map, localize
	edo node scripts/processDiagnosticMessages.mjs src/compiler/diagnosticMessages.json
	edo node -e '
		const fs = require("fs"), path = require("path");
		const copyright = fs.readFileSync("scripts/CopyrightNotice.txt", "utf8").replace(/\r\n/g, "\n");
		// libs.json has comments (upstream reads it as JSONC)
		const libs = Function("return (" + fs.readFileSync("src/lib/libs.json", "utf8") + ")")();
		for (const lib of libs.libs) {
			const target = path.join("built/local", (libs.paths && libs.paths[lib]) || "lib." + lib + ".d.ts");
			fs.writeFileSync(target, copyright + "\n" + fs.readFileSync(path.join("src/lib", lib + ".d.ts"), "utf8").replace(/\r\n/g, "\n"));
		}
		const typesMap = fs.readFileSync("src/server/typesMap.json", "utf8");
		JSON.parse(typesMap);
		fs.writeFileSync("built/local/typesMap.json", typesMap.replace(/\r\n/g, "\n"));
	'
	edo node scripts/generateLocalizedDiagnosticMessages.mjs src/loc/lcl built/local \
		src/compiler/diagnosticMessages.generated.json

	# services (typescript.js): wrapped in "var ts", then post-processed
	BANNER="var ts = {}; ((module) => {"
	_bundle src/typescript/typescript.ts built/local/typescript.js --define:require=QQQQQQQ \
		--footer:js='})({ get exports() { return ts; }, set exports(v) { ts = v; if (typeof module !== "undefined" && module.exports) { module.exports = v; } } })'
	BANNER=""
	edo node -e '
		const fs = require("fs");
		let s = fs.readFileSync(process.argv[1], "utf8").replace(/QQQQQQQ/g, "require");
		let n = 0;
		s = s.replace(/var __toCommonJS .*/, () => (n++, "var __toCommonJS = (mod) => (__copyProps, mod); // Modified helper to skip setting __esModule."));
		if (n !== 1) throw new Error("expected one __toCommonJS, found " + n);
		fs.writeFileSync(process.argv[1], s);
	' built/local/typescript.js

	# tsc, tsserver, typingsInstaller, watchGuard, tsserverlibrary
	_bundle src/tsc/tsc.ts built/local/_tsc.js
	_compile_cache_shim tsc.js
	_bundle_public src/tsserver/server.ts built/local/_tsserver.js
	_compile_cache_shim tsserver.js
	_bundle_public src/typingsInstaller/nodeTypingsInstaller.ts built/local/_typingsInstaller.js
	_compile_cache_shim typingsInstaller.js
	_bundle src/watchGuard/watchGuard.ts built/local/watchGuard.js
	edo node -e '
		const fs = require("fs");
		const c = fs.readFileSync("scripts/CopyrightNotice.txt", "utf8").replace(/\r\n/g, "\n");
		const file = (name, text) => fs.writeFileSync("built/local/" + name, c + text.trim() + "\n");
		file("tsserverlibrary.js", `
if (typeof module !== "undefined" && module.exports) {
    module.exports = require("./typescript.js");
}
else {
    throw new Error("tsserverlibrary requires CommonJS; use typescript.js instead");
}`);
		file("tsserverlibrary.d.ts", `
import ts = require("./typescript.js");
export = ts;`);
	'

	# dts-services: type-check with the compiler just built, then bundle
	edo node built/local/tsc.js -b src/typescript
	edo node scripts/dtsBundler.mjs --entrypoint ./built/local/typescript/typescript.d.ts \
		--output ./built/local/typescript.d.ts
}

src_test() {
	# Upstream's test suite is a separate, large build (runtests); smoke-test the
	# compiler and the API as they will be installed.
	local t="${T}/smoke"
	mkdir -p "${t}" || die
	cat > "${t}/test.ts" <<-EOF || die
		export const m: Map<string, number> = new Map([["a", 1]]);
		document.body.textContent = String(m.get("a") ?? 0);
	EOF
	[[ $(node built/local/tsc.js --version) == "Version ${PV}" ]] || die "unexpected tsc --version"
	edo node built/local/tsc.js --strict --declaration --target es2022 --module es2022 \
		--outDir "${t}/out" "${t}/test.ts"
	[[ -f ${t}/out/test.js && -f ${t}/out/test.d.ts ]] || die "tsc emitted nothing"
	echo 'let n: number = "x";' > "${t}/bad.ts" || die
	node built/local/tsc.js --noEmit "${t}/bad.ts" && die "tsc accepted a type error"
	edo node -e '
		const ts = require(process.argv[1]);
		const sf = ts.createSourceFile("a.ts", "const a: number = 1;", ts.ScriptTarget.Latest);
		if (ts.version !== process.argv[2] || sf.statements.length !== 1) process.exit(1);
	' "${S}/built/local/typescript.js" "${PV}"
}

src_install() {
	# The npm package's layout (package.json "files"), in /usr/lib/typescript/VERSION
	local dir="/usr/lib/${PN}/${PV}"
	insinto "${dir}"
	doins package.json
	insinto "${dir}/lib"
	doins built/local/lib*.d.ts built/local/typesMap.json \
		built/local/{,_}tsc.js built/local/{,_}tsserver.js built/local/tsserverlibrary.js \
		built/local/typescript.js built/local/{,_}typingsInstaller.js built/local/watchGuard.js \
		built/local/{tsserverlibrary,typescript}.d.ts
	local d
	for d in built/local/*/diagnosticMessages.generated.json; do
		d=${d%/*}
		[[ ${d##*/} == enu ]] && continue
		insinto "${dir}/lib/${d##*/}"
		doins "${d}"/diagnosticMessages.generated.json
	done
	exeinto "${dir}/bin"
	doexe bin/tsc bin/tsserver

	# Versioned names: other TypeScript packages may own /usr/bin/tsc.
	dosym -r "${dir}/bin/tsc" "/usr/bin/tsc-${PV}"
	dosym -r "${dir}/bin/tsserver" "/usr/bin/tsserver-${PV}"

	dodoc README.md SECURITY.md ThirdPartyNoticeText.txt
}
