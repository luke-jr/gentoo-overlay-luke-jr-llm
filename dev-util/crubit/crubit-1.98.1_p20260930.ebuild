# Pin to exactly the Rust slot encoded in PV. The rustc-dev component (the
# compiler's own crates, see src_prepare) only exists for dev-lang/rust built
# with USE=dist;
# "dist(-)" makes the dev-lang/rust-bin alternative generated by rust.eclass
# unsatisfiable.
RUST_MIN_VER="$(ver_cut 1-3)"
RUST_MAX_VER="${RUST_MIN_VER}"
RUST_REQ_USE="dist(-)"

PYTHON_COMPAT=( python3_{12..15} )

inherit cargo cargo-stubs rust-toolchain

DESCRIPTION="Crubit's cc_bindings_from_rs (C++ bindings for Rust crates), for Chromium"
HOMEPAGE="https://github.com/google/crubit"
SRC_URI="
	https://github.com/google/crubit/archive/${CRUBIT_COMMIT}.tar.gz -> ${PN}-${CRUBIT_COMMIT}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${PN}-${CRUBIT_COMMIT}"

LICENSE="Apache-2.0-with-LLVM-exceptions"
# Dependent crate licenses (only the crates linked into cc_bindings_from_rs)
LICENSE+=" Apache-2.0 MIT Unicode-3.0 || ( MIT Unlicense )"
SLOT="${PV}"
# The dev-lang/rust slot this is built against.
CRUBIT_RUST_SLOT="$(ver_cut 1-3)"
KEYWORDS="~amd64 ~arm64"
# Crubit's tests need googletest + Bazel-only fixtures; Chromium doesn't run them either.
RESTRICT="test"

# Run time: the librustc_driver-<hash>.so this was linked against.
RDEPEND="dev-lang/rust:${CRUBIT_RUST_SLOT}"

QA_FLAGS_IGNORED="usr/lib/crubit/${PV}/bin/cc_bindings_from_rs"

src_prepare() {
	default

	# cc_bindings_from_rs links the compiler's own crates (rustc_driver,
	# rustc_middle, ...), the rustc-dev component. dev-lang/rust with USE=dist
	# builds it but only leaves it as a tarball in /usr/lib/rust/<slot>/dist/,
	# so build against a private sysroot: the installed std (symlinks) plus the
	# rustc-dev crates. Nothing is written to the system Rust, and they're only
	# needed here: at run time the binary just loads the installed
	# librustc_driver.
	#
	# This is unpacked here rather than in src_unpack: the files (including
	# proc-macro .so files) come from the dev-lang/rust build on this machine,
	# not from SRC_URI, so post-unpack checks for prebuilt binaries don't apply.
	# If dev-lang/rust ever installs rustc-dev into the slot's sysroot itself,
	# use that instead.
	local triple=$(rust_abi)
	local rustroot="${BROOT}/usr/lib/rust/${CRUBIT_RUST_SLOT}"
	local tarball="${rustroot}/dist/rustc-dev-${CRUBIT_RUST_SLOT}-${triple}.tar.xz"
	[[ -f ${tarball} ]] ||
		die "${tarball} not found; re-emerge dev-lang/rust:${CRUBIT_RUST_SLOT} with USE=dist"

	local sr="${WORKDIR}/sysroot/lib/rustlib/${triple}/lib"
	mkdir -p "${sr}" || die
	ln -s "${rustroot}/lib/rustlib/${triple}/lib/"* "${sr}/" || die

	einfo "Unpacking rustc-dev from ${tarball} ..."
	tar -xJf "${tarball}" -C "${WORKDIR}" --wildcards \
		"rustc-dev-${CRUBIT_RUST_SLOT}-${triple}/rustc-dev/lib/rustlib/${triple}/lib/*" ||
		die "Failed to unpack rustc-dev"
	local f
	for f in "${WORKDIR}/rustc-dev-${CRUBIT_RUST_SLOT}-${triple}/rustc-dev/lib/rustlib/${triple}/lib/"*; do
		# The tarball has an empty lib/self-contained/ (rust-std has one too).
		[[ -d ${f} && -z $(ls -A "${f}") ]] && continue
		[[ -e ${sr}/${f##*/} ]] && die "rustc-dev file ${f##*/} collides with the installed ${rustroot}/lib/rustlib/${triple}/lib"
		mv "${f}" "${sr}/" || die
	done

	# The rustc-dev rmeta files only work with the librustc_driver they were
	# built with; its -Cmetadata hash is in the file name. Make sure the
	# tarball belongs to the installed compiler, then link against the
	# installed (stripped) copy so the binary resolves exactly that file.
	local drv=( "${sr}"/librustc_driver-*.so )
	[[ ${#drv[@]} -eq 1 && -f ${drv[0]} ]] || die "rustc-dev contains no single librustc_driver"
	local installed="${rustroot}/lib/${drv[0]##*/}"
	[[ -f ${installed} ]] ||
		die "${tarball} does not match the installed rustc (${installed} missing); re-emerge dev-lang/rust:${CRUBIT_RUST_SLOT}"
	ln -sf "${installed}" "${drv[0]}" || die
}

src_compile() {
	# rustc_private and Crubit's other nightly features on a stable compiler.
	# (Chromium already exports RUSTC_BOOTSTRAP=1 for its own build.)
	local -x RUSTC_BOOTSTRAP=1
	# --sysroot: see src_prepare. rpath: like build_crubit.py's
	# GetRustcDriverRpathFlags(), but pointing at the system Rust slot.
	# Not "local": cargo_env unsets RUSTFLAGS in a subshell after moving it into
	# CARGO_TARGET_*_RUSTFLAGS, and unsetting a caller's local re-exposes the
	# global value (e.g. RUSTFLAGS from make.conf), which cargo would then use
	# instead, without these flags. Phase functions don't leak variables anyway.
	RUSTFLAGS+=" --sysroot=${WORKDIR}/sysroot"
	RUSTFLAGS+=" -C link-arg=-Wl,-rpath,${EPREFIX}/usr/lib/rust/${CRUBIT_RUST_SLOT}/lib"
	# librustc_driver links libLLVM-<major>.so of the system LLVM that
	# dev-lang/rust was built against; it is found at runtime via LLVM's LDPATH,
	# but the linker needs its directory.
	local llvm_major
	llvm_major=$("${RUSTC}" -vV | sed -n 's/^LLVM version: \([0-9]*\)\..*/\1/p')
	[[ -n ${llvm_major} ]] || die "Could not determine the LLVM version of ${RUSTC}"
	RUSTFLAGS+=" -L native=${BROOT}/usr/lib/llvm/${llvm_major}/$(get_libdir)"

	# Same selection as build_crubit.py: --locked, only the one binary.
	cargo_src_compile --locked -p cc_bindings_from_rs --bin cc_bindings_from_rs

	# Smoke test: loads the installed librustc_driver via the rpath.
	"$(cargo_target_dir)"/cc_bindings_from_rs --help >/dev/null ||
		die "cc_bindings_from_rs does not run"
}

src_install() {
	# Same layout as Chromium's prebuilt toolchain package
	# (tools/rust/build_crubit.py: InstallCrubit()), rooted per Rust slot.
	local root="/usr/lib/crubit/${PV}"
	exeinto "${root}/bin"
	doexe "$(cargo_target_dir)"/cc_bindings_from_rs

	insinto "${root}/lib/third_party/crubit"
	doins -r BUILD.gn LICENSE crubit.gni support

	dodoc README.md
}

pkg_postinst() {
	elog "cc_bindings_from_rs is installed in ${EROOT}/usr/lib/crubit/${PV}/bin and is"
	elog "tied to the exact dev-lang/rust:${CRUBIT_RUST_SLOT} build installed now. If you rebuild"
	elog "dev-lang/rust:${CRUBIT_RUST_SLOT} (different flags can change its librustc_driver hash),"
	elog "rebuild ${CATEGORY}/${PN}:${SLOT} as well."
}
