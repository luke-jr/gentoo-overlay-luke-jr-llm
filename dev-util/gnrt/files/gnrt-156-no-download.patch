Build gnrt without its crate downloader (`gnrt vendor` fetching crates from
crates.io), and so without reqwest, flate2 and tar and their ~140 dependencies
(HTTP, TLS, ...). Only `gnrt gen` is used.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -16,7 +16,6 @@
 anyhow = "1"
 cargo-platform = "0.2"
 clap = { version = "4", features = ["derive"] }
-flate2 = "1"
 glob = "0.3.3"
 guppy = "0.19.0"
 handlebars = "6.3.2"
@@ -25,7 +24,6 @@
 once_cell = "1"
 proc-macro2 = "1.0.103"
 rayon = "1.12.0"
-reqwest = { version = "0.12", features = ["blocking"] }
 semver = "1"
 serde = { version = "1", features = ["derive"] }
 serde_json = "1"
@@ -33,7 +31,6 @@
 strum = "0.27.1"
 strum_macros = "0.27.1"
 syn = { version = "2.0.110", features = ["full", "visit"] }
-tar = "0.4"
 target-spec = "3.4.2"
 tempfile = "3"
 toml = "0.8"
