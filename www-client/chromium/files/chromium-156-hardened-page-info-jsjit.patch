index 7f22647e5e..4bbb1c8e30 100644
--- a/chrome/browser/ui/views/page_info/page_info_view_factory.cc
+++ b/chrome/browser/ui/views/page_info/page_info_view_factory.cc
@@ -324,6 +324,7 @@ const ui::ImageModel PageInfoViewFactory::GetPermissionIcon(
                          : vector_icons::kPhotoChromeRefreshOldIcon);
       break;
     case ContentSettingsType::JAVASCRIPT:
+    case ContentSettingsType::JAVASCRIPT_JIT:
       icon = show_blocked_badge
                  ? &(features::IsRoundedIconsEnabled()
                          ? vector_icons::kCodeOffIcon
@@ -652,6 +653,7 @@ const ui::ImageModel PageInfoViewFactory::GetPermissionIcon(
                                               : vector_icons::kPhotoOldIcon);
       break;
     case ContentSettingsType::JAVASCRIPT:
+    case ContentSettingsType::JAVASCRIPT_JIT:
       icon = &(features::IsRoundedIconsEnabled() ? vector_icons::kCodeIcon
                                                  : vector_icons::kCodeOldIcon);
       break;
