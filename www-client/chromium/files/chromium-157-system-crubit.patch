diff --git a/build/rust/std/prebuilt_std_bindings.gni b/build/rust/std/prebuilt_std_bindings.gni
new file mode 100644
index 0000000..6fdb732
--- /dev/null
+++ b/build/rust/std/prebuilt_std_bindings.gni
@@ -0,0 +1,205 @@
+# Copyright 2026 Gentoo Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Gentoo: C++ bindings for the crates of a *prebuilt* Rust stdlib, for use with
+# a system Crubit (`rust_crubit_root`).
+#
+# Upstream generates `rs_core.h`/`rs_alloc.h`/`rs_std.h` in
+# `//build/rust/std/rules` by running Crubit over the stdlib *sources* it
+# builds itself.  With a prebuilt stdlib there are no such targets, so this
+# template runs `cc_bindings_from_rs` in `.rmeta` mode over the stdlib that
+# ships with the rustc in `rust_sysroot`, producing the same outputs (same
+# header paths, C++ namespaces and `crate_*` metadata) as the upstream
+# `cpp_api_from_rust` template does for `//build/rust/std/rules:*_bindings`.
+
+import("//build/config/rust.gni")
+
+# Parameters
+#
+#   crate_name
+#     Name of the stdlib crate ("core", "alloc" or "std").
+#
+#   deps (optional)
+#     Bindings targets (of this template) of the crates `crate_name` depends
+#     on.
+#
+#   extern_crates (optional)
+#     Names of the stdlib crates of `deps`; passed to Crubit as `--extern`.
+template("prebuilt_std_cpp_api_from_rust") {
+  assert(enable_cpp_api_from_rust && rust_prebuilt_stdlib &&
+         rust_crubit_root != "")
+
+  _crate_name = invoker.crate_name
+  _cpp_namespace = "rs::${_crate_name}"
+  _h_out = "$root_gen_dir/third_party/crubit/support/rs_std/rs_${_crate_name}.h"
+  _rs_out = "${_h_out}.impl.rs"
+  _features = [
+    # Keep in sync with `_globally_enabled_crubit_features` in
+    # `//build/rust/gni_impl/cpp_api_from_rust.gni`.
+    "always_specialize_generics_in_cpp_api_from_rust",
+  ]
+
+  _rspgen_target_name = "${target_name}_crubit_rspgen"
+  _action_target_name = "${target_name}_crubit_action"
+  _rust_impl_target_name = "${target_name}_crubit_impl"
+  _h_target_name = target_name
+  _metadata_target_name = "${target_name}_crubit_metadata"
+  _action_rsp_path = "$target_out_dir/$_action_target_name.rsp"
+
+  _deps = []
+  if (defined(invoker.deps)) {
+    _deps = invoker.deps
+  }
+
+  _cpp_api_from_rust_exe_path = "$rust_crubit_root/bin/cc_bindings_from_rs"
+  _rustc_exe_path = "$rust_sysroot/bin/rustc"
+  _rustfmt_exe_path = "$rust_sysroot/bin/rustfmt"
+  _rustfmt_config_path = "//.rustfmt.toml"
+
+  # A pure metadata target, as `cpp_api_from_rust` has (its users collect the
+  # `--crate-header`/`--crate-namespace`/`--crate-feature` of their deps from
+  # `<dep>_crubit_metadata`, e.g. `//build/rust/std:std_bindings_crubit_metadata`).
+  group(_metadata_target_name) {
+    _gen_dir_relative_h_out = rebase_path(_h_out, root_gen_dir)
+    _crate_feature = []
+    foreach(_feature, _features) {
+      _crate_feature += [ "--crate-feature=${_crate_name}=${_feature}" ]
+    }
+    metadata = {
+      crate_feature = _crate_feature
+      crate_header =
+          [ "--crate-header=${_crate_name}=${_gen_dir_relative_h_out}" ]
+      crate_namespace = [ "--crate-namespace=${_crate_name}=${_cpp_namespace}" ]
+    }
+  }
+
+  # `--crate-header`/`--crate-namespace`/`--crate-feature` of the direct deps.
+  _rspgen_deps = []
+  foreach(_dep, _deps) {
+    _rspgen_deps += [ "${_dep}_crubit_metadata" ]
+  }
+  generated_file(_rspgen_target_name) {
+    deps = _rspgen_deps
+    outputs = [ _action_rsp_path ]
+    data_keys = [
+      "crate_feature",
+      "crate_header",
+      "crate_namespace",
+    ]
+    walk_keys = []  # Only metadata of direct, non-transitive `deps`.
+    visibility = [ ":${_action_target_name}" ]
+  }
+
+  action(_action_target_name) {
+    script = "//build/rust/std/prebuilt_std_bindings.py"
+    deps = [ ":${_rspgen_target_name}" ]
+    visibility = [
+      ":$_h_target_name",
+      ":$_rust_impl_target_name",
+    ]
+    inputs = [
+      _cpp_api_from_rust_exe_path,
+      _rustc_exe_path,
+      _rustfmt_exe_path,
+      _rustfmt_config_path,
+    ]
+    outputs = [
+      _h_out,
+      _rs_out,
+    ]
+
+    # Lists the stdlib `.rmeta` files that were used.
+    depfile = "$target_out_dir/$_action_target_name.d"
+
+    # Wrapper flags:
+    args = [
+      "--cpp-api-from-rust-exe-path",
+      rebase_path(_cpp_api_from_rust_exe_path, root_build_dir),
+      "--rustc",
+      rebase_path(_rustc_exe_path, root_build_dir),
+      "--target",
+      rust_abi_target,
+      "--crate",
+      _crate_name,
+      "--depfile",
+      rebase_path(depfile, root_build_dir),
+      "--depfile-target",
+      rebase_path(_h_out, root_build_dir),
+
+      # Re-run when the toolchain changes. Not read by the script.
+      "--rustc-revision",
+      rustc_revision,
+    ]
+    if (defined(invoker.extern_crates)) {
+      foreach(_extern, invoker.extern_crates) {
+        args += [
+          "--extern-crate",
+          _extern,
+        ]
+      }
+    }
+
+    # `cc_bindings_from_rs` flags, as in `cpp_api_from_rust.gni` (minus the
+    # rustc flags; the wrapper adds the `.rmeta` mode flags):
+    args += [
+      "--",
+      "@" + rebase_path(_action_rsp_path, root_build_dir),
+      "--h-out",
+      rebase_path(_h_out, root_build_dir),
+      "--rs-out",
+      rebase_path(_rs_out, root_build_dir),
+      "--portable-abi-compatible",
+      "--crubit-support-path-format",
+      "\"third_party/crubit/support/{header}\"",
+      "--rustfmt-exe-path",
+      rebase_path(_rustfmt_exe_path, root_build_dir),
+      "--rustfmt-config-path",
+      rebase_path(_rustfmt_config_path, root_build_dir),
+      "--crate-namespace",
+      "self=${_cpp_namespace}",
+    ]
+    foreach(_feature, _features) {
+      args += [
+        "--crate-feature",
+        "self=${_feature}",
+      ]
+    }
+    if (rust_crubit_clang_format != "") {
+      inputs += [ rust_crubit_clang_format ]
+      args += [
+        "--clang-format-exe-path",
+        rebase_path(rust_crubit_clang_format, root_build_dir),
+      ]
+    }
+  }
+
+  # The Rust half of the bindings (thunks), compiled against the prebuilt
+  # stdlib like any other Rust target.
+  rust_library(_rust_impl_target_name) {
+    deps = [
+      ":$_action_target_name",
+      "//build/rust/crubit:cpp_api_from_rust_bindings_rs_deps",
+    ]
+    visibility = [ ":$_h_target_name" ]
+    crate_name = "${_crate_name}_crubit_prebuilt_std"
+    output_name = crate_name
+    crate_root = _rs_out
+    sources = [ crate_root ]
+    configs += [ "//build/rust:default_edition" ]
+  }
+
+  source_set(_h_target_name) {
+    forward_variables_from(invoker, [ "visibility" ])
+    deps = _deps + [
+             ":$_action_target_name",
+             ":$_rust_impl_target_name",
+           ]
+
+    # `**public**_deps` to propagate `include_dirs` for including Crubit
+    # support libraries.
+    public_deps = [ "//build/rust/crubit:cpp_api_from_rust_bindings_cpp_deps" ]
+
+    public = [ _h_out ]
+  }
+}
diff --git a/build/rust/std/prebuilt_std_bindings.py b/build/rust/std/prebuilt_std_bindings.py
new file mode 100755
index 0000000..c568b47
--- /dev/null
+++ b/build/rust/std/prebuilt_std_bindings.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+
+# Copyright 2026 Gentoo Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Runs `cc_bindings_from_rs` in `.rmeta` mode over a crate of the prebuilt Rust
+# stdlib that ships with `--rustc`. See prebuilt_std_bindings.gni.
+
+import argparse
+import glob
+import os
+import subprocess
+import sys
+
+
+def rustc_print(rustc, what, target, env):
+    cmd = [rustc, "--print", what]
+    if target:
+        cmd += ["--target", target]
+    out = subprocess.check_output(cmd, env=env).decode().strip()
+    if not out or not os.path.isdir(out):
+        sys.exit(f"prebuilt_std_bindings.py: `{' '.join(cmd)}` printed "
+                 f"{out!r}, which is not a directory")
+    return out
+
+
+def find_rmeta(libdir, crate):
+    matches = sorted(glob.glob(os.path.join(libdir, f"lib{crate}-*.rmeta")))
+    if len(matches) != 1:
+        sys.exit(f"prebuilt_std_bindings.py: expected exactly one "
+                 f"lib{crate}-*.rmeta in {libdir}, found {len(matches)}: "
+                 f"{matches}")
+    return matches[0]
+
+
+def main():
+    try:
+        sep = sys.argv.index("--")
+    except ValueError:
+        sys.exit("prebuilt_std_bindings.py: missing `--` before the "
+                 "cc_bindings_from_rs flags")
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--cpp-api-from-rust-exe-path", required=True)
+    parser.add_argument("--rustc", required=True)
+    parser.add_argument("--target", required=True)
+    parser.add_argument("--crate", required=True)
+    parser.add_argument("--extern-crate", action="append", default=[])
+    parser.add_argument("--depfile", required=True)
+    parser.add_argument("--depfile-target", required=True)
+    parser.add_argument("--rustc-revision")
+    args = parser.parse_args(sys.argv[1:sep])
+    tool_args = sys.argv[sep + 1:]
+
+    env = dict(os.environ)
+    # cc_bindings_from_rs is a rustc driver; a stable rustc needs this for the
+    # unstable features it uses (the Chromium toolchain is nightly).
+    env["RUSTC_BOOTSTRAP"] = "1"
+
+    sysroot = rustc_print(args.rustc, "sysroot", None, env)
+    libdir = rustc_print(args.rustc, "target-libdir", args.target, env)
+
+    rmetas = {}
+    for crate in [args.crate] + args.extern_crate:
+        rmetas[crate] = find_rmeta(libdir, crate)
+
+    cmd = [
+        args.cpp_api_from_rust_exe_path,
+        *tool_args,
+        "--enable-rmeta-interface",
+        f"--source-crate-name={args.crate}",
+        f"--target={args.target}",
+        f"--sysroot={sysroot}",
+    ]
+    for crate, path in rmetas.items():
+        cmd.append(f"--extern={crate}={path}")
+
+    r = subprocess.run(cmd, env=env, check=False)
+    if r.returncode != 0:
+        sys.exit(r.returncode if r.returncode > 0 else 1)
+
+    with open(args.depfile, "w") as f:
+        f.write(f"{args.depfile_target}: {' '.join(rmetas.values())}\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
