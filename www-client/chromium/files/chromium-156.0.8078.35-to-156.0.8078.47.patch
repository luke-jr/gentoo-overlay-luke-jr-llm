+        mojo::PendingRemote<network::mojom::blink::CacheStorageSideDataWriter>(
+            remote.PassPipe(), version));
+  } else {
+    resource_response_->SetCacheStorageSideDataWriter(mojo::NullRemote());
+  }
+}
