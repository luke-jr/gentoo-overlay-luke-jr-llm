+// found in the LICENSE file.
+
+module network.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+
+// An interface representing a capability to write code cache metadata (side
+// data) directly to a specific CacheStorageCache entry in the browser process.
+// Passed with URLResponseHead and FetchAPIResponse so an untrusted renderer
+// process can invoke it directly to write code cache metadata for that entry
+// without relying on bucket or cache name string lookups.
+interface CacheStorageSideDataWriter {
+  // Writes side data to the underlying CacheStorageCache entry bound to this
+  // writer. May only be called once per writer instance; the writer
+  // self-destructs after a single call or if the underlying entry is
+  // invalidated.
+  WriteSideData(mojo_base.mojom.BigBuffer data);
+};
