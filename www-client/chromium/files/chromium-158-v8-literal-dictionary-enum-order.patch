The fix for crbug 577314726 (restricted: "[runtime] Walk literal NameDictionary
properties in enum order"): V8 main commit 740f16ea2382b74c8ad7b1b7c9b7411ba1de54c0
(main@{#111941}), merged to V8's 15.8 branch (158's) as
17fc9dcbf8e136649af1e09c1790f1e979debd03, right after 15.8.62.38, and to 15.9 (159's).
158's DEPS still pins V8 19c06df29e00 (15.8.62.38), as of 8127@{#1785}.

DeepWalk builds an object literal's nested AllocationSite list in descriptor
order while the boilerplate has fast properties. If DeepCopy then normalizes
the boilerplate to a NameDictionary, it walked the dictionary's hash buckets,
out of insertion order, so AllocationSiteUsageContext got out of step and
attributed ElementsKind feedback to the wrong site in release builds. Page
scripts reach it.

This is the 15.8 merge's runtime-literals.cc change (its mjsunit test is left
out); its parent is 158's V8 revision, so it applies as is. Drop this once
158's DEPS rolls V8 to 17fc9dcb or later.

diff --git a/v8/src/runtime/runtime-literals.cc b/v8/src/runtime/runtime-literals.cc
index c594525..0b70ae0 100644
--- a/v8/src/runtime/runtime-literals.cc
+++ b/v8/src/runtime/runtime-literals.cc
@@ -156,15 +156,22 @@
           if (copying) dict->ValueAtPut(i, *value);
         }
       } else {
+        // Iterate in enumeration order so traversal stays in sync with the
+        // nested AllocationSite list built by DeepWalk if a fast boilerplate is
+        // later normalized to a NameDictionary by JSObject::MigrateInstance.
         DirectHandle<NameDictionary> dict(copy->property_dictionary(), isolate);
-        for (InternalIndex i : dict->IterateEntries()) {
-          Tagged<Object> raw = dict->ValueAt(i);
+        DirectHandle<FixedArray> key_indices =
+            NameDictionary::IterationIndices(isolate, dict);
+        uint32_t key_indices_len = key_indices->ulength().value();
+        for (uint32_t i = 0; i < key_indices_len; i++) {
+          InternalIndex key_index(Smi::ToInt(key_indices->get(i)));
+          Tagged<Object> raw = dict->ValueAt(key_index);
           if (!IsJSObject(raw)) continue;
-          DCHECK(IsName(dict->KeyAt(i)));
+          DCHECK(IsName(dict->KeyAt(key_index)));
           Handle<JSObject> value(Cast<JSObject>(raw), isolate);
           ASSIGN_RETURN_ON_EXCEPTION(isolate, value,
                                      VisitElementOrProperty(copy, value));
-          if (copying) dict->ValueAtPut(i, *value);
+          if (copying) dict->ValueAtPut(key_index, *value);
         }
       }
     }
