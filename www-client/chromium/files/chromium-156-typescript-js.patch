# Use the JavaScript TypeScript compiler bundled in the source tree (run by
# the system Node.js) instead of the prebuilt native tsgo binary, which is
# removed together with all other bundled ELF binaries.

diff --git a/third_party/devtools-frontend/src/scripts/build/typescript/typescript_vars.gni b/third_party/devtools-frontend/src/scripts/build/typescript/typescript_vars.gni
index bc34d3a90c..69f878685f 100644
--- a/third_party/devtools-frontend/src/scripts/build/typescript/typescript_vars.gni
+++ b/third_party/devtools-frontend/src/scripts/build/typescript/typescript_vars.gni
@@ -6,7 +6,9 @@ import("//build/toolchain/rbe.gni")
 import("../ninja/vars.gni")
 
 if (host_os == "linux") {
-  tsc_binary = "//third_party/typescript/linux-amd64/src/lib/tsc"
+  # Gentoo: use the JavaScript TypeScript compiler bundled with DevTools
+  # (run by the system Node.js) instead of the prebuilt native tsgo binary.
+  tsc_binary = devtools_location_prepend + "node_modules/typescript/bin/tsc"
 } else if (host_os == "win") {
   tsc_binary = "//third_party/typescript/windows-amd64/src/lib/tsc.exe"
 } else if (host_os == "mac") {
