+void PageStabilityMonitor::OnFirstContentfulPaint() {
+  if (state_ != State::kMonitorStartDelay) {
+    return;
+  }
+
+  start_monitoring_delayed_handle_.CancelTask();
+  MoveToState(State::kWaitForNavigation);
+}
