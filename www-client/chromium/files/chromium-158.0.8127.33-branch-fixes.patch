+    {
+      CJS_Runtime::BlockingScope scope2(&runtime);
+      EXPECT_TRUE(runtime.IsBlocking());
+    }
+    EXPECT_TRUE(runtime.IsBlocking());
+  }
+  EXPECT_FALSE(runtime.IsBlocking());
+}
