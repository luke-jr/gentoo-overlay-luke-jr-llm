The fix for crbugs 580868681 and 580866198 (restricted: "Make it harder for
page popups to have a dangling opener_web_view_."): chromium/src main commit
abd9d181b70aec327c4f3f8d6736ab425c988f11 (main@{#1744370}), merged to the 159
branch as 9f52a3287d5101538c5795226e8463c3d4e3c1a1 (8154@{#599}). No 158 merge
has been proposed, as of 8127@{#1794}.

A page popup (the <select> menu, date/time and colour pickers) keeps a raw
pointer to the WebViewImpl that opened it (WebPagePopupImpl's
opener_web_view_). A page could open a popup while its WebView was closing,
or let script that runs during popup opening move the owner element into
another Page or an inactive document, so the popup outlived its opener: a
use-after-free in the renderer, reachable from web content.

This is the main commit's change without its test (internal_popup_menu_test.cc),
regenerated against 158's files so it applies without offsets; the hunks are
the same as main's and 159's merge. Drop this once 158 gets the fix (check
that the merged change is the same).

diff --git a/third_party/blink/renderer/core/exported/web_view_impl.cc b/third_party/blink/renderer/core/exported/web_view_impl.cc
index 5aca41e..5ce2967 100644
--- a/third_party/blink/renderer/core/exported/web_view_impl.cc
+++ b/third_party/blink/renderer/core/exported/web_view_impl.cc
@@ -660,7 +660,9 @@ WebViewImpl::WebViewImpl(
 
 WebViewImpl::~WebViewImpl() {
   DCHECK(!page_);
-  DCHECK(!page_popup_);
+  // A page popup must never outlive its opener WebViewImpl: its
+  // `opener_web_view_` is a raw pointer that would dangle.
+  CHECK(!page_popup_);
 }
 
 void WebViewImpl::SetTabKeyCyclesThroughElements(bool value) {
@@ -1079,6 +1081,10 @@ WebInputEventResult WebViewImpl::SendContextMenuEvent() {
 
 WebPagePopupImpl* WebViewImpl::OpenPagePopup(PagePopupClient* client) {
   CHECK(client);
+  if (is_closing_) {
+    // In Close(), we cannot create a new page popup.
+    return nullptr;
+  }
 
   // Make sure there is never more than one page popup active at a time.
   CancelPagePopup();
@@ -1091,7 +1097,21 @@ WebPagePopupImpl* WebViewImpl::OpenPagePopup(PagePopupClient* client) {
     return nullptr;
   }
 
-  LocalFrame* opener_frame = client->OwnerElement().GetDocument().GetFrame();
+  // CancelPagePopup() above (and NotifyPopupOpeningObservers() in the callers)
+  // can run author script synchronously, before the popup client has recorded
+  // the popup it is about to open. That script may move the owner element into
+  // a document that belongs to a different WebView, or into one that is no
+  // longer active. A popup created in that state would be bound to `this`
+  // through `opener_web_view_` while ChromeClientImpl::DocumentDetached() no
+  // longer recognizes it as ours, so it would outlive `this`. Refuse to open
+  // the popup unless the owner still lives in an active document of our Page.
+  Document& owner_document = client->OwnerElement().GetDocument();
+  LocalFrame* opener_frame = owner_document.GetFrame();
+  if (!opener_frame || opener_frame->GetPage() != page_.Get() ||
+      !owner_document.IsActive()) {
+    return nullptr;
+  }
+
   WebLocalFrameImpl* web_opener_frame =
       WebLocalFrameImpl::FromFrame(opener_frame);
 
@@ -1218,6 +1238,8 @@ void WebViewImpl::Close() {
   DCHECK(AllInstances().Contains(this));
   AllInstances().erase(this);
 
+  is_closing_ = true;
+
   // Ensure if we have a page popup we cancel it immediately as we do not
   // want page popups to re-enter WebViewImpl during our shutdown.
   CancelPagePopup();
diff --git a/third_party/blink/renderer/core/exported/web_view_impl.h b/third_party/blink/renderer/core/exported/web_view_impl.h
index 1c4e22e..b231584 100644
--- a/third_party/blink/renderer/core/exported/web_view_impl.h
+++ b/third_party/blink/renderer/core/exported/web_view_impl.h
@@ -1029,6 +1029,9 @@ class CORE_EXPORT WebViewImpl final : public WebView,
   // native restoration. Reset on each lifecycle update.
   bool last_page_lifecycle_state_update_restored_from_bfcache_ = false;
 
+  // Whether we're currently in Close().
+  bool is_closing_ = false;
+
   // All the registered observers.
   base::ObserverList<WebViewObserver> observers_;
 };
