 			return nil, err
 		}
-		if len(matches) == 0 {
-			return nil, fmt.Errorf("glob matched no files: %q", path)
-		}
+		// Release tarballs leave out test data (e.g. third_party/wycheproof_testvectors/), so a
+		// glob may match nothing; the lists it feeds are only for tests.
 		// Switch from Windows to POSIX paths.
 		for _, match := range matches {
 			ret = append(ret, strings.ReplaceAll(match, "\\", "/"))
