+
+  cue_.SetInlineStyleProperty(
+      is_horizontal ? CSSPropertyID::kTop : CSSPropertyID::kLeft,
+      full_dimension ? (adjusted_position * 100 / full_dimension).ToDouble()
+                     : 100.0,
+      CSSPrimitiveValue::UnitType::kPercentage);
 }
 
