+      BasePage::FromHeapObject(object)->owner_identity();
+  return owner_identity == NEW_SPACE || owner_identity == NEW_LO_SPACE;
+#else
+  return HeapLayout::InYoungGeneration(object);
+#endif  // V8_ENABLE_SANDBOX
