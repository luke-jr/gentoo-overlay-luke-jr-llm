+    files = [
+        path
+        for path in generated_paths
+        if not any(c in path for c in ("*", "?", "[", "{"))
+    ]
+    globs = [
+        path
+        for path in generated_paths
+        if any(c in path for c in ("*", "?", "[", "{"))
+    ]
