+#ifndef MEDIA_GPU_WINDOWS_D3D12_SOFTWARE_RATE_CONTROLLER_H_
+#define MEDIA_GPU_WINDOWS_D3D12_SOFTWARE_RATE_CONTROLLER_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/time/time.h"
+#include "base/types/expected.h"
+#include "media/base/bitrate.h"
