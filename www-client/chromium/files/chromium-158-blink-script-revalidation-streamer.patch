The fix for crbug 574605993 (restricted: "[blink] Clear background streamer on
script revalidation"): chromium/src main commit
577caa435192dd4674a2366dc6323339e3c1aefe (main@{#1741429}), merged to the 159
branch as 3b4071105e68997ea7beb5e2a38be9e3f7aad68e (8154@{#533}, 2026-11-16).
The 158 branch has no merge of it as of 8127@{#1780}.

When a ScriptResource that used BackgroundResourceScriptStreamer was
revalidated, SetRevalidatingRequest() cleared streamer_ and cache_consumer_
but not background_streamer_. If the revalidation response then failed
(non-304), ResponseReceived() re-installed the previous response's decoded
text from the surviving background streamer, while the code cache handler was
bound to the new response: V8 ran one response's script with another's code
cache. The server controls the revalidation responses, so web pages reach it.

This is the main commit's script_resource.cc change (its unittest is left
out), regenerated against 158's file, which differs from the commit's parent
elsewhere in the file (the hunks apply 4 lines lower; the changed lines are
the commit's own). Drop this once 158 gets the merge.

diff --git a/third_party/blink/renderer/core/loader/resource/script_resource.cc b/third_party/blink/renderer/core/loader/resource/script_resource.cc
index c1f294e..6de5052 100644
--- a/third_party/blink/renderer/core/loader/resource/script_resource.cc
+++ b/third_party/blink/renderer/core/loader/resource/script_resource.cc
@@ -360,6 +360,7 @@ void ScriptResource::DestroyDecodedDataForFailedRevalidation() {
   source_text_ = ParkableString();
   // Make sure there's no streaming.
   DCHECK(!streamer_);
+  DCHECK(!background_streamer_);
   DCHECK_EQ(streaming_state_, StreamingState::kStreamingDisabled);
   SetDecodedSize(0);
   DCHECK(!cache_consumer_);
@@ -374,6 +375,7 @@ void ScriptResource::SetRevalidatingRequest(
     CHECK(streamer_->IsFinished());
     streamer_ = nullptr;
   }
+  background_streamer_ = nullptr;
   // Revalidation requests don't actually load the current Resource, so disable
   // streaming.
   DisableStreaming(ScriptStreamer::NotStreamingReason::kRevalidate);
