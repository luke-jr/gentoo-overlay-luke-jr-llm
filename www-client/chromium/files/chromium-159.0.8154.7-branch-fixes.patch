-    f'Update {expected_modules_path} after making sure the change is intended.',
-  ]
-  if added:
-    message.append('Added: ' + ', '.join(added))
-  if removed:
-    message.append('Removed: ' + ', '.join(removed))
-  raise ValueError('\n'.join(message))
-
-
