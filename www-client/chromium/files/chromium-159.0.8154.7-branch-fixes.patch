-
-  // As on chrome://new-tab-page, the logo is single-colored, white by default,
-  // in dark mode.
-  protected isLogoSingleColored_(): boolean {
-    return !!this.theme_ && (!!this.theme_.logoColor || this.theme_.isDark);
