+  if (status !=
+      drive_picker::DriveDisclaimerController::DisclaimerStatus::kAccepted) {
+    OnConsentKitError("Drive consent not confirmed by backend");
+    return;
+  }
+
+  VLOG(1) << "[DrivePickerHostUI] Handling decision consent. "
+             "Transitioning to Picker.";
