+void DrivePickerHostUI::RecordConsentKitLoadResult(
+    ConsentKitLoadResult result) {
+  base::UmaHistogramEnumeration("ContextualSearch.Drive.ConsentKitLoadResult",
+                                result);
+  consent_kit_timeout_result_.reset();
+}
