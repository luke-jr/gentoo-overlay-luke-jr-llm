-void ContextualTasksButton::RemoveLayerFromRegions(ui::Layer* old_layer) {
-  const std::vector<ui::Layer*> region_layers =
-      GetLayersInOrder(views::ViewLayer::kExclude);
-  if (std::ranges::contains(region_layers, old_layer)) {
