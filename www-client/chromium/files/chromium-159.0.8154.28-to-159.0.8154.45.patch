+          !has_attrs) {
+        if (try_catch.HasTerminated()) {
+          try_catch.ReThrow();
+          break;
+        }
+        try_catch.Reset();
+        continue;
+      }
+      if ((attrs & v8::ReadOnly) && (attrs & v8::DontDelete)) {
+        continue;
+      }
+    }
