diff --git a/chrome/browser/plugins/chrome_plugin_service_filter.cc b/chrome/browser/plugins/chrome_plugin_service_filter.cc
index 5085f81d..493017b 100644
--- a/chrome/browser/plugins/chrome_plugin_service_filter.cc
+++ b/chrome/browser/plugins/chrome_plugin_service_filter.cc
@@ -158,6 +158,11 @@
 void ChromePluginServiceFilter::RenderProcessExited(
     content::RenderProcessHost* host,
     const content::ChildProcessTerminationInfo& info) {
+  RenderProcessHostDestroyed(host);
+}
+
+void ChromePluginServiceFilter::RenderProcessHostDestroyed(
+    content::RenderProcessHost* host) {
   CHECK_CURRENTLY_ON(BrowserThread::UI, base::NotFatalUntil::M163);
   base::AutoLock auto_lock(lock_);
   plugin_details_.erase(host->GetDeprecatedID());
