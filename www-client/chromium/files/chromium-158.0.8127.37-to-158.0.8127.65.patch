+
+    def _is_valid_include_candidate(cand: str) -> bool:
+        return (
+            cand not in ("", ".")
+            and not cand.startswith(("/", "../"))
+            and not cand.startswith(COPYBARA_EXCLUDED_PREFIXES)
+            and not cand.startswith(glob_prefixes)
