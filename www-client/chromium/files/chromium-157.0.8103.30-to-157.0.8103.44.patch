+      UserPerformanceTuningManager::GetInstance();
+  // A survey for users who have turned off memory saver mode.
+  if (!manager->IsMemorySaverModeActive() &&
+      !manager->IsMemorySaverModeManaged() &&
+      !manager->IsMemorySaverModeDefault()) {
