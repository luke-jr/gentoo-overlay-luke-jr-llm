+// so the padding is what keeps the G 2dp smaller than its siblings, matching
+// the toolbar.
+ui::ImageModel CreatePaddedGoogleGIcon(const ui::ImageModel& icon,
+                                       ui::ColorId color_id,
+                                       const ui::ColorProvider& provider) {
+  const gfx::ImageSkia g_image =
