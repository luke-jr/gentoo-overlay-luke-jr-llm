+// Overrides the OS-mode-dependent threads rail tokens from
+// `AddWebThemeNewTabPageColors` for custom themes (autogenerated and
+// CWS/extension) so surfaces, text, tooltips, accents, dividers, scrollbars,
+// and state layers stay contrast-matched to the rail background rather than OS
+// dark mode. The remaining rail tokens (`BrandPrimaryFont`,
+// `BrandSecondaryFont`, `ContainerBackground`, `MenuOpenBackground`,
+// `SelectedBackground`, `Scrim`, and `UpdateDot`) are defined in
+// `AddWebThemeNewTabPageColors` via intra-rail ColorId aliases/transforms that
+// resolve lazily from the tokens overridden here or theme-independent `ui::`
+// tokens (`kColorSysStateScrim`).
+void AddCustomThemeThreadsRailColors(
+    ui::ColorMixer& mixer,
+    ui::ColorTransform element_background_color,
+    ui::ColorTransform primary_foreground_color) {
+  mixer[kColorNewTabPageThreadsRailPrimaryFont] = {primary_foreground_color};
+  mixer[kColorNewTabPageThreadsRailBackground] =
+      SelectBasedOnWhiteNtpBackground(gfx::kGoogleGrey100,
+                                      element_background_color);
+  mixer[kColorNewTabPageThreadsRailSecondaryFont] = ui::SelectBasedOnDarkInput(
+      kColorNewTabPageThreadsRailBackground,
+      ui::PickGoogleColor(gfx::kGoogleGrey700,
+                          kColorNewTabPageThreadsRailBackground,
+                          color_utils::kMinimumReadableContrastRatio),
+      ui::PickGoogleColor(gfx::kGoogleGrey500,
+                          kColorNewTabPageThreadsRailBackground,
+                          color_utils::kMinimumReadableContrastRatio));
+  const ui::ColorTransform elevated_surface =
+      ui::SelectBasedOnDarkInput(kColorNewTabPageThreadsRailBackground,
+                                 gfx::kGoogleGrey900, SK_ColorWHITE);
+  mixer[kColorNewTabPageThreadsRailFlyoutMenuBackground] = elevated_surface;
+  mixer[kColorNewTabPageThreadsRailTooltipContainer] = elevated_surface;
+  mixer[kColorNewTabPageThreadsRailSurfaceContainer] = elevated_surface;
+  mixer[kColorNewTabPageThreadsRailSurfaceContainerHigh] =
+      ui::SelectBasedOnDarkInput(kColorNewTabPageThreadsRailBackground,
+                                 gfx::kGoogleGrey800, gfx::kGoogleGrey100);
+  mixer[kColorNewTabPageThreadsRailPrimary] =
+      ui::PickGoogleColor(ui::kColorButtonBackgroundProminent,
+                          kColorNewTabPageThreadsRailBackground,
+                          color_utils::kMinimumVisibleContrastRatio);
+  const ui::ColorTransform hover_state = ui::SelectBasedOnDarkInput(
+      kColorNewTabPageThreadsRailBackground,
+      ui::SetAlpha(SK_ColorWHITE, 0.1f * SK_AlphaOPAQUE),
+      ui::SetAlpha(gfx::kGoogleGrey900, 0.1f * SK_AlphaOPAQUE));
+  mixer[kColorNewTabPageThreadsRailHoverBackground] = hover_state;
+  mixer[kColorNewTabPageThreadsRailSurfaceContainerHighest] = hover_state;
