+    [[nodiscard]] virtual bool appendStages(const SkStageRec&,
+                                            const SkShaders::MatrixRec&) const = 0;
 
     virtual SkImage* onIsAImage(SkMatrix*, SkTileMode[2]) const {
         return nullptr;
