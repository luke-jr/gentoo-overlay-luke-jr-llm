+  # api-extractor's rollups of the type declarations, which nothing imports.
+  "package/lib/es5-iife/puppeteer-core-browser.d.ts",
+  "package/lib/types.d.ts",
   "package/lib/puppeteer/common/EventEmitter.test.d.ts",
   "package/lib/puppeteer/common/EventEmitter.test.d.ts.map",
   "package/lib/puppeteer/common/EventEmitter.test.js.map",
