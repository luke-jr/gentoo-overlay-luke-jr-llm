"Fix unnecessary a11y alerts on app menu zoom event" (crbugs 575086736 and
579732980, not public; no CVE listed yet): the app menu's zoom view announced
zoom changes to accessibility even when they were in a background tab or the
active tab's zoom had not changed. It now remembers the active tab's zoom and
only updates when it changes. chromium/src main commit
609d2ee45a5f0d48fedad8e92e7128b42b3567b8, merged on 2026-11-02 to 157
(3f861aafd2ec31fb30e4232afe334e1a6095b5d4, after the 157.0.8103.41 tag). This
is the 157 merge, without its test. Drop it once a 157 tag has it.

diff --git a/chrome/browser/ui/views/toolbar/app_menu.cc b/chrome/browser/ui/views/toolbar/app_menu.cc
index 0d5179c..820463a 100644
--- a/chrome/browser/ui/views/toolbar/app_menu.cc
+++ b/chrome/browser/ui/views/toolbar/app_menu.cc
@@ -884,6 +884,13 @@
       if (zoom_controller) {
         zoom = zoom_controller->GetZoomPercent();
       }
+    }
+    if (!on_construction && zoom_percent_ == zoom) {
+      return;
+    }
+    zoom_percent_ = zoom;
+
+    if (contents) {
       increment_button_->SetEnabled(zoom < contents->GetMaximumZoomPercent());
       decrement_button_->SetEnabled(zoom > contents->GetMinimumZoomPercent());
     }
@@ -955,6 +962,9 @@
   // instead. This value is cached because is depends on multiple calls to
   // gfx::GetStringWidth(...) which are expensive.
   mutable std::optional<int> zoom_label_max_width_;
+
+  // Current zoom percent for the active tab.
+  std::optional<int> zoom_percent_;
 };
 
 BEGIN_METADATA(AppMenu, ZoomView)
