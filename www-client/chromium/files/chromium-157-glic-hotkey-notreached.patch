"Fix NOTREACHED crash on unregistered hotkeys in LocalHotkeyManager"
(crbugs 577212342 and 578571701, not public; no CVE listed yet): Cut, Copy
and Paste while the Gemini in Chrome (Glic) view had focus reached a fatal
NOTREACHED() in LocalHotkeyManager::GetCommand(), crashing the browser; now
an unregistered accelerator is just not handled. chromium/src main commit
39f2047b9d12e565920353b01e537a84a13d375e (2026-10-27), merged on 2026-11-02
to 157 (c6a52549e10cc2c2869e6c866570fe894aad080d, after the 157.0.8103.37
tag). This is the 157 merge, without its unit test. Drop it once a 157 tag
has it.

diff --git a/chrome/browser/glic/common/local_hotkey_manager.cc b/chrome/browser/glic/common/local_hotkey_manager.cc
index d68230c..0e9f878 100644
--- a/chrome/browser/glic/common/local_hotkey_manager.cc
+++ b/chrome/browser/glic/common/local_hotkey_manager.cc
@@ -205,9 +205,11 @@
   return accelerator;
 }
 
-LocalHotkeyManager::Command LocalHotkeyManager::GetCommand(
-    ui::Accelerator accelerator) {
-  CHECK(event_handler_);
+std::optional<LocalHotkeyManager::Command> LocalHotkeyManager::GetCommand(
+    const ui::Accelerator& accelerator) const {
+  if (!event_handler_ || accelerator.IsEmpty()) {
+    return std::nullopt;
+  }
 
   for (Command command : supported_commands_) {
     if (auto iter = kCommandToStaticAcceleratorsMap.find(command);
@@ -222,7 +224,7 @@
     }
   }
 
-  NOTREACHED() << accelerator.GetShortcutText() << " isn't a supported command";
+  return std::nullopt;
 }
 
 void LocalHotkeyManager::InitializeAccelerators() {
@@ -237,8 +239,11 @@
   if (!event_handler_) {
     return false;
   }
-  auto command = GetCommand(accelerator);
-  return event_handler_->AcceleratorPressed(command, accelerator);
+  std::optional<Command> command = GetCommand(accelerator);
+  if (!command.has_value()) {
+    return false;
+  }
+  return event_handler_->AcceleratorPressed(*command, accelerator);
 }
 
 bool LocalHotkeyManager::EventHandler::AcceleratorPressed(
@@ -256,14 +261,7 @@
 
 bool LocalHotkeyManager::IsRegisteredAccelerator(
     const ui::Accelerator& accelerator) const {
-  for (Command command : supported_commands_) {
-    for (const ui::Accelerator& registered_accel : GetAccelerators(command)) {
-      if (registered_accel == accelerator) {
-        return true;
-      }
-    }
-  }
-  return false;
+  return GetCommand(accelerator).has_value();
 }
 
 std::vector<ui::Accelerator> LocalHotkeyManager::GetAccelerators(
