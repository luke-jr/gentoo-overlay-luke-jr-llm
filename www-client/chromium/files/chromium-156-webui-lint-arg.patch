Add a GN arg, enable_webui_lint, to skip the ESLint and Stylelint checks that
WebUI builds run on their TypeScript and CSS. The checks only produce stamp
files, but they need ESLint, Stylelint, typescript-eslint and the TypeScript
npm package (some 170 npm packages, all of them shipped as generated JS),
which nothing else in the build uses. With enable_webui_lint=false the
eslint_ts() and stylelint() targets become empty groups.

diff -ru a/ui/webui/resources/tools/eslint_ts.gni b/ui/webui/resources/tools/eslint_ts.gni
--- a/ui/webui/resources/tools/eslint_ts.gni
+++ b/ui/webui/resources/tools/eslint_ts.gni
@@ -3,6 +3,7 @@
 # found in the LICENSE file.
 
 import("//third_party/node/node.gni")
+import("//ui/webui/webui_features.gni")
 
 # GN rule to run ESlint type-aware checks on TypeScript files. Unlike the ESLint
 # checks in tools/web_dev_style/eslint.config.mjs which are run on presubmit,
@@ -10,6 +11,20 @@
 # file) to run.
 
 template("eslint_ts") {
+  if (enable_webui_lint) {
+    eslint_ts_impl(target_name) {
+      forward_variables_from(invoker, "*")
+    }
+  } else {
+    # Other targets depend on the check; make it do nothing.
+    group(target_name) {
+      forward_variables_from(invoker, [ "visibility" ])
+      not_needed(invoker, "*")
+    }
+  }
+}
+
+template("eslint_ts_impl") {
   node(target_name) {
     script = "//ui/webui/resources/tools/eslint_ts.py"
 
diff -ru a/ui/webui/resources/tools/stylelint.gni b/ui/webui/resources/tools/stylelint.gni
--- a/ui/webui/resources/tools/stylelint.gni
+++ b/ui/webui/resources/tools/stylelint.gni
@@ -3,10 +3,25 @@
 # found in the LICENSE file.
 
 import("//third_party/node/node.gni")
+import("//ui/webui/webui_features.gni")
 
 # GN rule to run Stylelint checks on CSS files.
 
 template("stylelint") {
+  if (enable_webui_lint) {
+    stylelint_impl(target_name) {
+      forward_variables_from(invoker, "*")
+    }
+  } else {
+    # Other targets depend on the check; make it do nothing.
+    group(target_name) {
+      forward_variables_from(invoker, [ "visibility" ])
+      not_needed(invoker, "*")
+    }
+  }
+}
+
+template("stylelint_impl") {
   node(target_name) {
     script = "//ui/webui/resources/tools/stylelint.py"
 
diff -ru a/ui/webui/webui_features.gni b/ui/webui/webui_features.gni
--- a/ui/webui/webui_features.gni
+++ b/ui/webui/webui_features.gni
@@ -14,6 +14,10 @@
   # speed benefits at runtime (so we skip in debug builds).
   optimize_webui = !is_debug
 
+  # Whether to check WebUI TypeScript and CSS with ESLint and Stylelint during
+  # the build. The checks don't change the build output.
+  enable_webui_lint = true
+
   # Whether to inline source maps during build. Cannot be enabled when
   # `optimize_webui=true`.
   enable_webui_inline_sourcemaps = use_javascript_coverage
