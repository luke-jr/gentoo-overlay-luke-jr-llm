+namespace actor {
+
+// A tool that executes a dynamic JavaScript code string in the target frame,
+// in the actor's isolated world.
+class ExecuteJsTool : public ToolBase {
+ public:
+  ExecuteJsTool(content::RenderFrame& frame,
+                TaskId task_id,
+                Journal& journal,
