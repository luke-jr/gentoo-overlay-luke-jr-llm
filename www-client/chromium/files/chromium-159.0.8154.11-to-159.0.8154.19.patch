+constexpr char kAIMDisplayMode[] = "50";
+// The value for the "atvm" (AIM Threads Visibility Mode) query parameter.
+// value "3" corresponds to Threads Visibility Mode "Always Open".
+constexpr char kAIMThreadsVisibilityMode[] = "3";
