+  profile->GetPrefs()->SetInteger(
+      contextual_search::kDriveConsentState,
+      static_cast<int>(contextual_search::DriveConsentState::kConsent));
+
+  if (delegate_) {
+    delegate_->OnTransitionToPicker();
